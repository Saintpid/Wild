# saving: the patterns, the lengths, the sounds and the settings come back after a power cycle;
# never a flash write by itself while it plays; SAVE held resets
wait 200
# track 2 (snare): a metal sound, one bar, a hit on step 6 (w5), Edge 80
tap OCT+
tap ENV
tap ENV
spin K1 4
tapkey b10
tap HOME
spin K1 -1
wait 10
expect len 16
tapkey w5
tap ENV
spin K3 30
expect tpar10 80
wait 30
expect kind1 5
expect step5 1
# playing: nothing saves by itself
tap PLAY
expect store_writes 0
wait 5000
expect store_writes 0
tap PLAY
# stopped and quiet: it saves by itself
wait 6000
expect store_writes 1
expect dirty 0
reboot
wait 200
expect track 0
tap OCT+
expect kind1 5
expect len 16
expect step5 1
expect tpar10 80
expect tpar6 5
shot restored.png
# SAVE held: RESET?, SAVE again: the starting set
press SAVE
wait 1600
release SAVE
tap SAVE
wait 30
expect kind1 1
expect len 32
expect tpar10 50
expect dirty 1
# SAVE: the preset list, SAVE again: preset 001
tap SAVE
expect store_writes 1
tap SAVE
expect store_writes 2
expect preset 0
