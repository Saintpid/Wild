# CLEAR ALL: GLO + HOME asks, GLO + HOME again says yes (a key or SAVE keeps): every bank empty, all
# automation gone, bank 1 empty (no hits or notes, 1 bar Fixed, nothing by chance); the saved songs stay. GLO + REC: the selected track's automation goes.
wait 200
tap FX
spin K1 30
expect tpar15 30
# automation on track 1's reverb and on the 303 (track 5)
tap PLAY
tap REC
turn K1 5 80
tap REC
expect lanes 1
tap OCT-
expect track 4
tap REC
turn K1 5 80
tap REC
expect lanes 2
# GLO + REC on the 303: its automation goes, track 1's stays
press GLO
tap REC
release GLO
expect lanes 1
expect rec 0
expect view 6
# again: nothing left there
press GLO
tap REC
release GLO
expect lanes 1
tap PLAY
# a bank 3 and a saved song
tap SEL
tapkey w2

expect banks 5
tap SAVE
tapkey w0
tap SAVE
expect preset 0
# GLO + HOME, then something else: kept
press GLO
tap HOME
release GLO
expect view 6
tapkey w4
expect banks 5
# GLO + HOME, SAVE: kept too
press GLO
tap HOME
release GLO
tap SAVE
expect list 0
expect banks 5
# GLO + HOME twice: all clear
press GLO
tap HOME
release GLO
press GLO
tap HOME
release GLO
expect view 6
expect bank 0
expect banks 1
expect lanes 0
tap OCT+
tap FX
expect tpar15 0
# an empty start: no hits, no 303 notes, 1 bar Fixed, nothing by chance
expect hits 0
expect len 16
expect tpar0 1
expect tpar1 0
expect tpar4 0
expect tpar5 0
expect tpar8 0
expect tpar25 0
expect gpar2 0
expect gpar4 0
expect gpar5 0
expect anotes 0
expect alen 16
expect apar0 1
expect apar6 0
expect apar24 0
expect apar25 0
tap PLAY
wait 3000
expect hits 0
expect anotes 0
tap PLAY
shot cleared.png
tap SEL
tapkey w2

expect lanes 0
# the saved song still has it all
tap ARP
tapkey w0
tap ARP
wait 20
expect banks 5
expect lanes 1
expect dropped 0
