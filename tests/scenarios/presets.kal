# presets: SAVE opens the list (a slot by SELECT, OCT-/+, PRESETS or a white key), SAVE again saves;
# ARP opens it to load, ARP again loads; Program Change loads. The Master page: GLOBAL's first. Undo / redo:
# black 3 / 4.
wait 200
# the Master page and back
tap FX
expect view 4
tap GLO
expect view 8
spin K1 -40
expect gpar12 60
spin K4 70
expect gpar15 100
shot master.png
# the Glue page, GLOBAL's second: its mix, EQ, color, width
tap GLO
expect view 9
spin K1 50
expect gpar21 100
spin K3 50
expect gpar23 100
spin K4 -60
expect gpar24 0
wait 1000
shot glue_page.png
spin K4 65
expect gpar24 65
tap FX
expect view 4
# play with the glue at 100, all of it in, the inflator at 100: no louder for it (matched), never over its
# ceiling (-1 dBFS)
tap PLAY
wav glue.wav
wait 3000
wavstop
expect peak_db_max -0.95
expect peak_db_min -16
tap PLAY
# a state to keep: Hi cut 60, Tune +5 on the kick
tap ENV
tap ENV
spin K3 5
expect tpar14 5
# SAVE: the list on slot 001; down 2 by SELECT, up 1 by OCT+: 004 ... white key 3: 003
tap SAVE
expect list 1
expect slot 0
turn SELECT 2
expect slot 2
tap OCT+
expect slot 3
tapkey w2
expect slot 2
shot savelist.png
tap SAVE
expect list 0
expect preset 2
# changed after: Tune 0, Hi cut open
spin K3 -5
expect tpar14 0
tap GLO
spin K1 40
expect gpar12 100
tap ENV
tap ENV
# ARP: the list on 003, load
tap ARP
expect list 2
expect slot 2
shot loadlist.png
tap ARP
wait 20
expect list 0
expect tpar14 5
expect gpar12 60
# an empty slot: kept
tap ARP
turn PRESET 10
expect slot 12
tap ARP
wait 20
expect tpar14 5
# any other button closes the list
tap SAVE
expect list 1
tap HOME
expect list 0
expect view 3
# Program Change 3 (slot 003 is 2), on channel 1, while playing
tap ENV
tap ENV
spin K3 -5
expect tpar14 0
tap PLAY
midi C0 02
wait 50
expect tpar14 5
expect playing 1
expect preset 2
tap PLAY
expect dropped 0
# undo / redo on black 3 / 4: one knob turn is one edit
tap GLO
tap GLO
tap GLO
expect view 10
spin K2 10
expect gpar1 10
wait 2000
spin K2 10
expect gpar1 20
tapkey b2
expect gpar1 10
tapkey b2
expect gpar1 0
tapkey b3
expect gpar1 10
tapkey b3
expect gpar1 20
tapkey b3
expect gpar1 20
# a mute, undone
tapkey b4
expect mute 1
tapkey b2
expect mute 0
shot undo.png
