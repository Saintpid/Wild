# SEL's modes, on the Scene page (GLOBAL's fifth). A/B: two scenes to work on and swap; Copy: a copy to
# play with, SEL again back to the original (what was done in the copy is gone). GLOBAL opens on Master.
wait 200
tap GLO
expect view 8
tap GLO
tap GLO
tap GLO
tap GLO
expect view 12
expect gpar19 0
spin K1 1
expect gpar19 1
tap PLAY
# A/B: the first SEL keeps A and goes on in B (the same, to begin with)
tap SEL
expect scene 1
tap FX
spin K1 30
expect tpar15 30
tapkey b9
wait 50
shot scene_b.png
tap SEL
wait 50
expect scene 0
expect tpar15 0
expect gpar19 1
tap SEL
wait 50
expect scene 1
expect tpar15 30
tap SEL
wait 50
expect tpar15 0
# Copy: SEL again back to the original, the copy's changes gone
tap GLO
tap GLO
tap GLO
tap GLO
tap GLO
expect view 12
spin K1 1
expect gpar19 2
expect scene 0
tap SEL
expect scene 1
tap FX
spin K1 50
expect tpar15 50
tap SEL
wait 50
expect scene 0
expect tpar15 0
tap SEL
expect scene 1
expect tpar15 0
spin K1 20
expect tpar15 20
tap SEL
wait 50
expect tpar15 0
expect gpar19 2
expect dropped 0
