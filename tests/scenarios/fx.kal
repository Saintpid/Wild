# effects per track: the selected track's sends and inserts on FX, its modulation effect on FX again, the
# bus on FX a third time; Chaos brings glitches (beat repeat, reverse, tape stop); a drive changes the
# colour, not the loudness
wait 200
tap FX
expect view 4
# the kick's: no reverb, no delay, no filter, drive 25
expect tpar15 0
expect tpar18 25
spin K1 40
expect tpar15 40
shot trackfx.png
tap FX
expect view 5
# the kick's modulation effect: off, then a phaser on every hit
expect tpar19 0
expect tpar22 60
spin K1 1
expect tpar19 1
spin K4 40
expect tpar22 100
shot modfx.png
tap FX
expect view 6
shot fxbus.png
# SEL: a scene by chance (the kick's reverb is 40 before it); SEL again: back
tap SEL
expect scene 1
# in the scene, the mute keys set the original's mutes: the kick muted after it
tapkey b4
tap SEL
expect scene 0
expect mute 1
tapkey b4
expect mute 0
expect tpar15 40
expect tpar19 1
expect tpar22 100
expect mute 0
# the acid line's own
tap OCT-
tap FX
expect view 4
expect apar16 10
expect apar19 35
spin K4 20
expect apar19 55
# Chaos up: glitches come; Mutade up: in bars 4 and 8 other tracks play, and always back after
tap LFO
spin K1 60
expect gpar4 100
spin K3 100
expect gpar18 100
tap PLAY
wav chaos.wav
wait 8000
wavstop
expect glitches >0
# a beat repeat is an eighth at most (two sixteenths: 200)
expect repeat_max <201
expect mutades >0
expect peak_db_max -0.2
tap PLAY
wait 50
expect mutediff 0
expect dropped 0
