# MIDI in: nseq's notes (C1.. a new pattern per track, C2 all), the controllers, the clock
wait 200
# CC 112: reverb amount; 0 switches it off
midi B0 70 7F
wait 10
expect gpar6 100
midi B0 70 0
wait 10
expect gpar6 0
# CC 102: deviance on every track
midi B0 66 0
wait 10
expect tpar8 0
tap OCT+
expect tpar8 0
tap OCT-
# C1 (36): a new pattern on track 1, and it starts playing
expect playing 0
midi 90 24 64
wait 30
expect playing 1
# a channel set: other channels are ignored
spin ALGO -1
spin ALGO -1
expect view 11
spin K2 5
expect gpar11 5
midi B0 70 7F
wait 10
expect gpar6 0
midi B4 70 7F
wait 10
expect gpar6 100
spin K2 -5
# the clock: 24 ticks a beat at 20 ms = 125 BPM, followed; the tempo knob waits (the ticks are timed
# by the 256-frame block they land in, +-3 ms: within 2 %)
clock 60 20
expect ext 1
expect bpm >1225
expect bpm <1275
shot ext.png
# stop (FC), start (FA): from the top
midi FC 0 0
wait 10
expect playing 0
midi FA 0 0
wait 10
expect playing 1
# no ticks for a while: our own tempo again
wait 700
expect ext 0
expect bpm 1120
# CC 123: stop
midi B0 7B 0
wait 10
expect playing 0
expect dropped 0
