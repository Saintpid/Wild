# BANKS: SEL held and a white key. Keys 1-8 a bank each, a whole project (patterns, sounds, effects,
# settings) with the tempo shared; an empty one starts as a copy. Key 16: a new scene by chance at each
# press. SEL let go after a bank key does nothing else; tap SEL then key 1 goes back to bank 1. Saved when quiet.
wait 200
expect bank 0
expect banks 1
# (track 1 stays as it is: no Evolve)
spin K4 -100
tap PLAY
expect patkeep0 0
# bank 2: new, a copy of bank 1
tap SEL
tapkey w1

expect bank 1
expect banks 3
expect scene 0
expect patmoved0 0
# bank 2 changes: track 1's reverb, a new pattern, the tempo
tap FX
spin K1 30
expect tpar15 30
tapkey b9
expect patmoved0 1
expect patkeep0 0
tap GLO
tap GLO
tap GLO
expect view 13
spin K1 8
expect gpar0 120
shot bank2.png
# back to bank 1: its own reverb and pattern, the tempo stays
tap SEL
tapkey w0

wait 50
expect bank 0
expect scene 0
expect tpar15 0
expect patmoved0 1
expect gpar0 120
# bank navigation is undoable as one operation
tapkey b2
expect bank 1
expect tpar15 30
tapkey b3
expect bank 0
expect tpar15 0
# to bank 2 again: as it was left
tap SEL
tapkey w1

wait 50
expect bank 1
expect tpar15 30
expect patmoved0 0
# key 16: a scene by chance, a new one at each press; leaving keeps the bank's original
press SEL
tapkey w15
expect scene 1
tapkey w15
expect scene 1
release SEL
tap SEL
tapkey w0
wait 50
expect scene 0
expect bank 0
tap SEL
tapkey w1

wait 50
expect tpar15 30
expect patmoved0 0
# no bank on keys 9-15
tap SEL
tapkey w12

expect bank 1
tap SEL
# tap SEL then key 1: back to bank 1
tap SEL
tapkey w0
expect scene 0
expect bank 0
expect tpar15 0
tap SEL
tapkey w1

expect tpar15 30
# playing: nothing saved; stopped and quiet: the project and the banks
expect store_writes 0
tap PLAY
wait 6000
expect bankdirty 0
expect store_writes >1
expect dirty 0
reboot
wait 200
expect bank 1
expect banks 3
expect tpar15 30
tap SEL
tapkey w0

wait 50
expect tpar15 0
expect gpar0 120
expect dropped 0
