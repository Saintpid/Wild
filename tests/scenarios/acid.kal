# the acid line, track 5: its pages, its steps (a note, its pitch, accent and slide on the held key),
# its pattern and sound keys, its mute on black 9, MIDI E1 and CC 74 / 71, and that it is heard
wait 200
expect alen 16
expect anotes >3
# track 5: OCT- from track 1 (wraps), or SELECT
tap OCT-
expect track 4
shot acid_track.png
# its pattern page: Bars 1 -> 2 (from another page: HOME on Pattern goes on to Rhythm)
tap EDIT
tap HOME
expect view 0
spin K1 1
expect apar0 2
wait 20
expect alen 32
# its sound page: Cutoff
tap ENV
spin K1 10
expect apar8 40
shot acid_sound.png
# its tone page: Chaos on KNOB 4, 25 to 0 and up to 100
tap ENV
spin K4 -30
expect apar24 0
spin K4 120
expect apar24 100
shot acid_tone.png
# a step: step 16 (w15) of bar 1, empty: a press sets the root with an accent, again plain, again off
expect aflags15 0
tapkey w15
wait 20
expect aflags15 3
tapkey w15
wait 20
expect aflags15 1
tapkey w15
wait 20
expect aflags15 0
# a slid note with an accent loses the accent first and keeps the slide
tapkey w15
wait 20
key w15 down
wait 20
spin K3 1
key w15 up
wait 20
expect aflags15 7
tapkey w15
wait 20
expect aflags15 5
tapkey w15
wait 20
expect aflags15 0
tapkey w15
wait 20
expect aflags15 3
# held: KNOB 1 its note, KNOB 2 accent on, KNOB 3 slide on
key w15 down
wait 20
spin K1 7
spin K2 1
spin K3 1
wait 20
key w15 up
wait 20
expect anote15 7
expect aflags15 7
# black 9: mute track 5, again: on
tapkey b8
expect apar7 1
leds
tapkey b8
expect apar7 0
# black 11: a new sound (its settings drawn, any wave, an octave: Tune -24..+24 in 12s), black 10: a new pattern
tapkey b10
expect apar14 >-25
expect apar14 <25
tapkey b9
wait 20
expect anotes >3
# play, the drums muted: it sounds alone, its steps walk
tapkey b4
tapkey b5
tapkey b6
tapkey b7
tap PLAY
wav acid.wav
wait 3000
expect alast >-1
shot acid_playing.png
wavstop
expect peak_db_min -24
expect peak_db_max -0.2
tapkey b4
tapkey b5
tapkey b6
tapkey b7
# unmuted, a track is selected: track 4 now; OCT+ back to the acid line
expect track 3
tap OCT+
expect track 4
# CC 74 cutoff, CC 71 reso; E1 a new pattern
midi B0 4A 7F
midi B0 47 0
wait 20
expect apar8 100
expect apar9 0
midi 90 28 64
wait 20
tap PLAY
expect alast -1
# saved with the project: step 6 up two octaves, and after a power cycle it is there
key w5 down
wait 20
spin K1 40
key w5 up
wait 20
expect anote5 24
wait 6000
expect dirty 0
reboot
wait 200
expect anote5 24
expect aflags5 >0
expect apar8 100
expect apar24 100
expect alen 32
# the drum tracks still: OCT- to track 5, OCT+ back to track 1
tap OCT-
tap OCT+
expect track 0
expect dropped 0
